{
  "name": "gfm-escape",
  "version": "0.2.0",
  "description": "Markdown and GFM escaper for converting plaintext into escaped Markdown",
  "main": "dist/gfm-escape.cjs.js",
  "module": "dist/gfm-escape.esm.js",
  "browser": "dist/gfm-escape.umd.js",
  "scripts": {
    "lint": "eslint --ext .js,.mjs .",
    "prebuild": "npm run lint",
    "build": "rollup -c",
    "pretest": "npm run build",
    "test": "jasmine --config=test/jasmine.json",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orchitech/gfm-escape.git"
  },
  "dependencies": {
    "union-replacer": "^2.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "cmark-gfm": "^0.7.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jasmine": "^5.13.0",
    "jasmine-diff": "^0.1.3",
    "jsdom": "^29.1.1",
    "jsesc": "^3.1.0",
    "node-addon-api": "^3",
    "rollup": "^4.63.0"
  },
  "keywords": [
    "markdown",
    "gfm",
    "escape",
    "turndown"
  ],
  "files": [
    "dist"
  ],
  "author": "Martin Cizek <martin.cizek@orchitech.cz>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orchitech/gfm-escape/issues"
  },
  "homepage": "https://github.com/orchitech/gfm-escape#readme"
}
